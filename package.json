{
  "name": "dnd-master-screen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DM screen controller: show Notion images on the players' monitor",
  "scripts": {
    "start": "NODE_ENV=production bun src/server.ts",
    "dev": "bun --hot src/server.ts",
    "sync": "bun src/sync/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@notionhq/client": "^5.28.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
